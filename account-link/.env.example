# ===== Discord アプリ（Bot トークンは不要・使用しない）=====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 外部公開URL（本番は HTTPS 必須）。Developer Portal > OAuth2 > Redirects に ${PUBLIC_BASE_URL}/callback を登録
PUBLIC_BASE_URL=https://link.example.com
PORT=3000
# リバースプロキシ配下なら true（X-Forwarded-For を流入レート制限に使う）
TRUST_PROXY=false

# 暗号鍵（64桁hex）。生成: node src/cli.js gen-key
# 紛失すると保存データを復号できません。漏えいした場合は全データを削除して鍵を作り直してください。
MASTER_KEY=

# ===== 同意画面・プライバシーポリシーに表示する内容（必須）=====
APP_NAME=Discord アカウント連携
# 利用目的を具体的に書く（例: 「〇〇コミュニティのイベント当選連絡と、GitHub アカウントの本人確認のため」）
APP_PURPOSE=
OPERATOR_NAME=
PRIVACY_CONTACT=
PRIVACY_POLICY_VERSION=2026-09-23
# 保存期間（日）。過ぎたデータは自動で削除
DATA_RETENTION_DAYS=365

DATA_DIR=data
LOG_DIR=logs
