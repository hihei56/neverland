
# ===== 必須 =====
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id
# Botを操作できるユーザーID（あなた自身）。カンマ区切り
BOT_OWNER_IDS=
# 操作対象として許可するギルドID。復元先の新サーバーもここに追加する。カンマ区切り
ALLOWED_GUILD_IDS=

# ===== 任意 =====
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=info
# API書き込みの最小間隔(ms)
QUEUE_INTERVAL_MS=350
MAX_ASSET_BYTES=10485760

# ===== メンバー再参加機能（OAuth2 同意制・任意）=====
OAUTH_ENABLED=false
DISCORD_CLIENT_SECRET=
# 外部公開URL（HTTPS推奨）。Developer Portal の Redirects に ${PUBLIC_BASE_URL}/oauth/callback を登録
PUBLIC_BASE_URL=https://backup.example.com
HTTP_PORT=3000
# リバースプロキシ配下のときだけ true（X-Forwarded-For を信用してIP判定・レート制限に使う）。
# 直接公開する場合は false のまま（false だと XFF を偽装できるため）。
TRUST_PROXY=false
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# true にするとトークン等を暗号化せず平文で保存する（管理者の明示的な選択・非推奨）。
# 平文は漏えい時にメンバーのトークン/メールがそのまま流出するので、通常は false のまま。
TOKEN_PLAINTEXT=false
PRIVACY_POLICY_VERSION=2026-09-23
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT=

# 認証成功時に付与するロール（任意）。"guildId:roleId,guildId:roleId" 形式
VERIFY_ROLE_IDS=
# 認証成功を記録するログチャンネル（任意）。"guildId:channelId,guildId:channelId" 形式
AUTH_LOG_CHANNEL_IDS=
# 再参加1件ごとの待機(ms)
MEMBER_JOIN_DELAY_MS=750

# ===== 荒らし対策の追加取得（すべて既定 false・任意で有効化）=====
# 有効にする場合は必ず /privacy とサーバー掲示で周知すること。
# email/connections は本人がOAuth認可画面で許可した場合のみ取得（Bot権限では取得不可）。
VERIFY_COLLECT_EMAIL=false
VERIFY_COLLECT_CONNECTIONS=false
# IPは既定でHMACハッシュのみ記録（同一IP判定用、生IPは残さない）
VERIFY_LOG_IP=false
# 生IPまで暗号化保存する（VPN判定等が必要な場合のみ・取り扱い注意）
VERIFY_LOG_IP_RAW=false
